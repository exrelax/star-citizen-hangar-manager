{
  "name": "star-citizen-hangar-manager",
  "description": "Browser extension for managing the Star Citizen hangar on robertsspaceindustries.com.",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "wxt",
    "dev:chrome": "wxt -b chrome",
    "dev:firefox": "wxt -b firefox",
    "build": "pnpm build:chrome && pnpm build:firefox",
    "build:chrome": "wxt build -b chrome",
    "build:firefox": "wxt build -b firefox",
    "zip": "pnpm zip:chrome && pnpm zip:firefox",
    "zip:chrome": "wxt zip -b chrome",
    "zip:firefox": "wxt zip -b firefox",
    "site:dev": "vite --config site/vite.config.ts",
    "site:build": "vite build --config site/vite.config.ts",
    "site:preview": "vite preview --config site/vite.config.ts",
    "compile": "vue-tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "postinstall": "wxt prepare",
    "svg-sprite": "node ./scripts/build-icon-sprites.js",
    "icons": "node ./scripts/build-extension-icons.js"
  },
  "dependencies": {
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@wxt-dev/i18n": "^0.2.8",
    "@wxt-dev/module-vue": "^1.0.3",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.0",
    "happy-dom": "^21.0.4",
    "marked": "^18.1.3",
    "prettier": "^3.9.10",
    "svgo": "^4.1.0",
    "typescript": "~6.0.3",
    "vite": "8.3.5",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.14",
    "wxt": "^0.21.5"
  },
  "license": "MIT"
}
